# Backend (BFF). This is the only process that may hold the API key.

# The GameFlow gateway, including the /v1 prefix.
GAMEFLOW_API_URL=https://api.gameflow.gg/v1
# Org scoped key from Settings -> API keys in the dashboard.
# Never put this in the client or the game server.
GAMEFLOW_API_KEY=
GAMEFLOW_GAME_ID=
# Must match the mode the matchmaker was published for.
GAMEFLOW_GAME_MODE=1v1
GAMEFLOW_REGION=us-east

# Shared with the game server. Signs the session token the server checks at
# connect time, and guards /internal/match-result.
GAME_BACKEND_API_TOKEN=

# Signs the long lived player token the client holds. Keep it different from
# the backend API token: a leak of one must not grant the other.
JWT_SECRET=

PORT=8080
# How long a player waits before being told nobody was found.
QUEUE_TIMEOUT_SECONDS=90
