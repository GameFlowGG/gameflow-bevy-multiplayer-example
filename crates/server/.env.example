# Game server. No GameFlow API key here, by design.
#
# The server runs on GameFlow, not on your machine: GameFlow builds it from the
# uploaded zip and allocates one per match, injecting these values through the
# game's environment variables in the dashboard. This file documents what to set
# there.

# Where the server posts the match result: your hosted backend's public URL.
GAME_BACKEND_URL=
# Must be byte for byte the same as the backend's GAME_BACKEND_API_TOKEN.
GAME_BACKEND_API_TOKEN=
